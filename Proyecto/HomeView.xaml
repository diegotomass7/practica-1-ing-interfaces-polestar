<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Polestar.HomeView">
    <ScrollViewer x:Name="HomeScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid MinHeight="{Binding ViewportHeight, ElementName=HomeScroll}">
            <Grid Margin="48,18,48,24" MaxWidth="1250">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="355" Margin="0,12,0,22">
                    <TextBlock Style="{StaticResource Body}" Foreground="#F0EDE8" Text="Sala de exposición"/>
                    <TextBlock Style="{StaticResource Body}" Foreground="#E1E1E4" Text="Descubre la gama eléctrica Polestar." Margin="0,0,0,26"/>
                    <TextBlock Style="{StaticResource Eyebrow}" Foreground="#FFD19A" Text="NOVEDAD"/>
                    <TextBlock Style="{StaticResource Title}" Foreground="White" FontSize="56" Text="Polestar 5"/>
                    <TextBlock Style="{StaticResource Body}" Foreground="#E1E1E4" Text="Gran turismo eléctrico" Margin="0,0,0,18"/>
                    <Button HorizontalAlignment="Left" Click="Explore">
                        <AccessText Text="_Explorar la galería" TextWrapping="Wrap"/>
                    </Button>
                </StackPanel>
                <UniformGrid Grid.Row="1" Columns="2">
                    <Border Style="{StaticResource Panel}" Margin="0,0,6,0" Padding="16">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Eyebrow}" Text="PRECIO DE ENTRADA"/>
                            <TextBlock Style="{StaticResource Heading}" Text="Polestar 2"/>
                            <TextBlock Style="{StaticResource Body}" Text="Desde 42.000 €" Margin="0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Panel}" Margin="6,0,0,0" Padding="16">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Eyebrow}" Text="CAMPAÑA DE OTOÑO"/>
                            <TextBlock Style="{StaticResource Heading}" Text="1.500 € de descuento"/>
                            <TextBlock Style="{StaticResource Body}" Text="Para el Polestar 2." Margin="0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
