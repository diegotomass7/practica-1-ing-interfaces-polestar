<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Polestar" x:Class="Polestar.MainWindow"
        Title="Polestar | Sala de exposición" Width="1220" Height="800"
        MinWidth="660" MinHeight="480" Language="es-ES" FontFamily="Segoe UI"
        FontSize="16" Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True" PreviewKeyDown="HandleMenuKeys">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.RowSpan="2" IsHitTestVisible="False">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsVisible, ElementName=Home}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.Background>
                <ImageBrush ImageSource="Assets/inicio-escandinavo.jpg" Stretch="UniformToFill"
                            AlignmentX="Right" AlignmentY="Center"/>
            </Grid.Background>
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#DC0A0B0D" Offset="0"/>
                        <GradientStop Color="#B00A0B0D" Offset="0.30"/>
                        <GradientStop Color="#210A0B0D" Offset="0.60"/>
                        <GradientStop Color="#000A0B0D" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#A0000000" Offset="0"/>
                        <GradientStop Color="#00000000" Offset="0.26"/>
                        <GradientStop Color="#00000000" Offset="0.74"/>
                        <GradientStop Color="#B0000000" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>
        <Grid Grid.RowSpan="2" IsHitTestVisible="False">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsVisible, ElementName=Login}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.Background>
                <ImageBrush ImageSource="Assets/portada.jpg" Stretch="UniformToFill"
                            AlignmentX="Center" AlignmentY="Center"/>
            </Grid.Background>
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#DC0A0B0D" Offset="0"/>
                        <GradientStop Color="#BF0A0B0D" Offset="0.36"/>
                        <GradientStop Color="#260A0B0D" Offset="0.64"/>
                        <GradientStop Color="#000A0B0D" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#A0000000" Offset="0"/>
                        <GradientStop Color="#00000000" Offset="0.26"/>
                        <GradientStop Color="#00000000" Offset="0.74"/>
                        <GradientStop Color="#B0000000" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>
        <Border BorderBrush="{DynamicResource StrokeBrush}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextBrush}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsVisible, ElementName=Home}" Value="True">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="TextElement.Foreground" Value="White"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsVisible, ElementName=Login}" Value="True">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="TextElement.Foreground" Value="White"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid Margin="24,0">
                <Button x:Name="MenuButton" Style="{StaticResource GalleryBack}" Width="46" Height="44"
                        Padding="0" HorizontalAlignment="Left" VerticalAlignment="Center"
                        AutomationProperties.Name="Abrir menú" ToolTip="Menú · Alt+M" Click="ToggleMenu">
                    <Path Width="19" Height="15" Stretch="Uniform" StrokeThickness="1.8"
                          Stroke="{DynamicResource TextBrush}" Data="M0,0 H18 M0,6 H18 M0,12 H18"/>
                </Button>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center"
                            AutomationProperties.Name="Polestar">
                    <Path Width="29" Height="29" Stretch="Uniform" Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}"
                          Data="M0,14 L17,8 24,0 20,13 14,17 Z M24,10 L7,16 0,24 4,11 10,7 Z"/>
                    <TextBlock Text="Polestar" FontSize="30" FontWeight="SemiBold" Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid x:Name="ContentHost" Grid.Row="1">
            <local:HomeView x:Name="Home" GalleryRequested="OpenGallery"/>
            <local:GalleryView x:Name="Gallery" Visibility="Collapsed"/>
            <local:LoginView x:Name="Login" Visibility="Collapsed"/>
        </Grid>
        <Grid x:Name="MenuOverlay" Grid.Row="1" Visibility="Collapsed">
            <Border Background="#88000000" MouseLeftButtonDown="DismissMenu"/>
            <Border Width="230" HorizontalAlignment="Left" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,1,0" Padding="14,18,14,14">
                <StackPanel KeyboardNavigation.TabNavigation="Cycle">
                    <RadioButton x:Name="HomeNav" GroupName="Navigation" Content="_Inicio" Tag="{StaticResource HomeIcon}"/>
                    <RadioButton x:Name="GalleryNav" GroupName="Navigation" Content="_Galería" Tag="{StaticResource GalleryIcon}"/>
                    <RadioButton x:Name="LoginNav" GroupName="Navigation" Content="I_dentificación" Tag="{StaticResource ProfileIcon}"/>
                    <Border Margin="4,12,4,6" Height="1" Background="{DynamicResource StrokeBrush}"/>
                    <CheckBox x:Name="ReduceMotion" Content="Reducir movimiento" Margin="6,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>


