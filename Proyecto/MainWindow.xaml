<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Polestar" x:Class="Polestar.MainWindow" Title="Polestar | Sala de exposición" Width="1050" Height="760" MinWidth="600" MinHeight="460" Language="es-ES" FontFamily="Segoe UI" FontSize="16" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="28,10" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="0,0,0,1">
            <WrapPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,30,0" AutomationProperties.Name="Polestar">
                    <Path Width="25" Height="25" Stretch="Uniform" Fill="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" Data="M0,14 L17,8 24,0 20,13 14,17 Z M24,10 L7,16 0,24 4,11 10,7 Z"/>
                    <TextBlock Text="Polestar" FontSize="23" FontWeight="SemiBold" Margin="9,0,0,0"/>
                </StackPanel>
                <RadioButton x:Name="HomeNav" GroupName="Navigation" Content="_Inicio" Tag="Home"/>
                <RadioButton x:Name="GalleryNav" GroupName="Navigation" Content="_Galería" Tag="Gallery"/>
                <RadioButton x:Name="LoginNav" GroupName="Navigation" Content="I_dentificación" Tag="Login"/>
                <CheckBox x:Name="ReduceMotion" Content="Reducir _movimiento" VerticalAlignment="Center"/>
            </WrapPanel>
        </Border>
        <Grid>
            <local:HomeView x:Name="Home" GalleryRequested="OpenGallery"/>
            <local:GalleryView x:Name="Gallery" Visibility="Collapsed"/>
            <local:LoginView x:Name="Login" Visibility="Collapsed"/>
        </Grid>
    </DockPanel>
</Window>

