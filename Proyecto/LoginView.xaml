<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Polestar.LoginView">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="48,28,48,36" MaxWidth="420" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource Eyebrow}" Foreground="#FFD19A" Text="ÁREA DE CLIENTES"/>
            <TextBlock Style="{StaticResource Title}" Foreground="White" Text="Identificación"/>
            <TextBlock Style="{StaticResource Body}" Foreground="#F0F0F2" Text="Acceso de demostración. Usa únicamente la cuenta de prueba."/>
            <Border Style="{StaticResource Panel}" Margin="0">
                <StackPanel>
                <Label x:Name="EmailLabel" Content="_Correo electrónico" Target="{Binding ElementName=Email}" Margin="0,10,0,0"/>
                <TextBox x:Name="Email" AutomationProperties.LabeledBy="{Binding ElementName=EmailLabel}" MaxLength="254"/>
                <Label x:Name="PasswordLabel" Content="_Contraseña" Target="{Binding ElementName=Secret}" Margin="0,14,0,0"/>
                <PasswordBox x:Name="Secret" AutomationProperties.LabeledBy="{Binding ElementName=PasswordLabel}" MaxLength="128"/>
                <Button Content="_Entrar" IsDefault="True" HorizontalAlignment="Stretch" Margin="0,16,0,0" Click="SignIn"/>
                <TextBlock x:Name="Feedback" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/>
                <Border Margin="0,10,0,0" Padding="12" Background="{DynamicResource ElevatedBrush}" CornerRadius="6">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Eyebrow}" Text="CUENTA DE PRUEBA"/>
                        <TextBlock Style="{StaticResource Body}" Margin="0,0,0,4" Text="cliente@example.com"/>
                        <TextBlock Style="{StaticResource Body}" Margin="0" Text="Contraseña: PolestarDemo1"/>
                    </StackPanel>
                </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>


