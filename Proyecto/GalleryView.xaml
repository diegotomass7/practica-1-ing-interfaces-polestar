<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Polestar.GalleryView"
             Background="{DynamicResource CanvasBrush}" PreviewKeyDown="HandleNavigationKey">
    <Grid>
        <ScrollViewer x:Name="CatalogScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="36,28,36,36" MaxWidth="1250">
                <TextBlock Style="{StaticResource Title}" Text="Galería"/>
                <TextBlock Style="{StaticResource Body}" Text="Selecciona un modelo para ver su ficha."/>
                <UniformGrid Columns="2" Margin="-6,0">
                    <Button Style="{StaticResource VehicleCard}" Tag="polestar-2" Click="OpenDetail"
                            AutomationProperties.Name="Ver ficha del Polestar 2">
                        <StackPanel>
                            <Image Source="Assets/polestar-2.jpg" Stretch="Uniform"/>
                            <DockPanel Margin="16,14,16,6">
                                <TextBlock DockPanel.Dock="Right" Text="↗" Foreground="{DynamicResource AccentBrush}" FontSize="19" Margin="8,0,0,0"/>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Heading}" Text="Polestar 2"/>
                                    <TextBlock Style="{StaticResource Body}" Text="Fastback eléctrico"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource VehicleCard}" Tag="polestar-3" Click="OpenDetail"
                            AutomationProperties.Name="Ver ficha del Polestar 3">
                        <StackPanel>
                            <Image Source="Assets/polestar-3.jpg" Stretch="Uniform"/>
                            <DockPanel Margin="16,14,16,6">
                                <TextBlock DockPanel.Dock="Right" Text="↗" Foreground="{DynamicResource AccentBrush}" FontSize="19" Margin="8,0,0,0"/>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Heading}" Text="Polestar 3"/>
                                    <TextBlock Style="{StaticResource Body}" Text="SUV eléctrico"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource VehicleCard}" Tag="polestar-4-coupe" Click="OpenDetail"
                            AutomationProperties.Name="Ver ficha del Polestar 4 coupé">
                        <StackPanel>
                            <Image Source="Assets/polestar-4-coupe.jpg" Stretch="Uniform"/>
                            <DockPanel Margin="16,14,16,6">
                                <TextBlock DockPanel.Dock="Right" Text="↗" Foreground="{DynamicResource AccentBrush}" FontSize="19" Margin="8,0,0,0"/>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Heading}" Text="Polestar 4 coupé"/>
                                    <TextBlock Style="{StaticResource Body}" Text="SUV coupé eléctrico"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource VehicleCard}" Tag="polestar-4-suv" Click="OpenDetail"
                            AutomationProperties.Name="Ver ficha del Polestar 4 SUV">
                        <StackPanel>
                            <Image Source="Assets/polestar-4-suv.jpg" Stretch="Uniform"/>
                            <DockPanel Margin="16,14,16,6">
                                <TextBlock DockPanel.Dock="Right" Text="↗" Foreground="{DynamicResource AccentBrush}" FontSize="19" Margin="8,0,0,0"/>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Heading}" Text="Polestar 4 SUV"/>
                                    <TextBlock Style="{StaticResource Body}" Text="SUV eléctrico de silueta familiar"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource VehicleCard}" Tag="polestar-5" Click="OpenDetail"
                            AutomationProperties.Name="Ver ficha del Polestar 5">
                        <StackPanel>
                            <Image Source="Assets/polestar-5.jpg" Stretch="Uniform"/>
                            <DockPanel Margin="16,14,16,6">
                                <TextBlock DockPanel.Dock="Right" Text="↗" Foreground="{DynamicResource AccentBrush}" FontSize="19" Margin="8,0,0,0"/>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Heading}" Text="Polestar 5"/>
                                    <TextBlock Style="{StaticResource Body}" Text="Gran turismo eléctrico"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Button>
                </UniformGrid>
            </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="DetailScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="36,28,36,36" MaxWidth="1080">
                <Button x:Name="BackButton" Content="← _Volver a la galería" Style="{StaticResource GalleryBack}"
                        HorizontalAlignment="Left" Click="CloseDetail" Margin="0,0,0,16"/>
                <TextBlock x:Name="DetailName" Style="{StaticResource Title}" AutomationProperties.LiveSetting="Polite"/>
                <TextBlock x:Name="DetailDescription" Style="{StaticResource Body}"/>
                <Border Style="{StaticResource Hero}" Background="{DynamicResource CanvasBrush}">
                    <Image x:Name="DetailPhoto" MaxHeight="330" Stretch="Uniform" Margin="0"/>
                </Border>
                <UniformGrid Columns="3" Margin="-4,0,0,10">
                    <Border Style="{StaticResource Panel}" Padding="12" Margin="4,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Eyebrow}" Text="PRECIO"/>
                            <TextBlock x:Name="DetailPrice" Style="{StaticResource Heading}" FontSize="20" Margin="0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Panel}" Padding="12" Margin="4,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Eyebrow}" Text="AUTONOMÍA WLTP"/>
                            <TextBlock x:Name="DetailRange" Style="{StaticResource Heading}" FontSize="20" Margin="0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Panel}" Padding="12" Margin="4,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Eyebrow}" Text="POTENCIA"/>
                            <TextBlock x:Name="DetailPower" Style="{StaticResource Heading}" FontSize="20" Margin="0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
                <TextBlock x:Name="DetailNote" Style="{StaticResource Body}" FontSize="13" Margin="0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

